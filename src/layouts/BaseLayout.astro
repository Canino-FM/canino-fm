---
import { ClientRouter } from 'astro:transitions'

interface Props {
	title?: string
	description?: string
	/** Skip the timed header/logo intro; useful while developing. */
	skipIntro?: boolean
	/**
	 * Play the intro only on the first page view of a browsing session. Later views
	 * (e.g. returning from an artist page) skip it. Ignored when `skipIntro` is set.
	 */
	introOncePerSession?: boolean
}

const {
	title = 'Canino FM',
	description = 'Canino FM — independent community radio, Barcelona.',
	skipIntro = false,
	introOncePerSession = false,
} = Astro.props

/** The intro can be skipped before paint, so the anti-flash CSS has to be present. */
const maySkipIntro = skipIntro || introOncePerSession

/**
 * Runs synchronously as the first thing in <body>, before the header is parsed, so the
 * class lands ahead of first paint and the symbol never flashes full-viewport.
 * Marks the session on the first view, so this page view plays the intro and later ones skip it.
 */
const introOnceScript = `(function () {
	try {
		if (sessionStorage.getItem('canino:intro-seen')) {
			document.body.classList.add('skip-intro')
		} else {
			sessionStorage.setItem('canino:intro-seen', '1')
		}
	} catch (e) {
		/* Storage unavailable (private mode, blocked cookies): play the intro. */
	}
})()`
---

<!doctype html>
<html lang="en" class="no-js" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{
			maySkipIntro ? (
				<style is:inline>
					/* Before bundled component CSS (notably in dev), avoid a full-viewport symbol flash. */
					body.skip-intro .header .symbol {
						height: calc(117 / 1920 * 100vw);
						transition: none;
					}
					body.skip-intro .header .logo-wrapper {
						width: calc(860 / 1920 * 100vw);
						transition: none;
					}
					@media (max-width: 767px) {
						body.skip-intro .header .symbol {
							height: calc(59 / 375 * 100vw);
						}
						body.skip-intro .header .logo-wrapper {
							/* Mirrors Header.astro's mobile rule, which is the source of truth. */
							top: calc(10 / 375 * 100vw);
							left: calc(50 / 375 * 100vw);
							height: calc(40 / 375 * 100vw);
							width: calc(320 / 375 * 100vw);
						}
					}
				</style>
			) : null
		}
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#fff" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<meta name="msapplication-TileImage" content="/mstile-270x270.png" />
		<title>{title}</title>
		{/* Client-side navigation, so the player survives page changes. `transition:animate="none"`
		   on <html> keeps navigation looking as it did with full page loads. */}
		<ClientRouter />
	</head>
	<body class:list={[{ 'skip-intro': skipIntro }]}>
		{introOncePerSession && !skipIntro ? <script is:inline set:html={introOnceScript} /> : null}
		<slot />
	</body>
</html>

<script>
	import { swapFunctions } from 'astro:transitions/client'

	/**
	 * Body children marked with this survive navigation untouched, so the player keeps
	 * streaming from page to page.
	 *
	 * Astro's own `transition:persist` is not enough: in browsers without
	 * `Element.moveBefore` it re-parents the element, and moving an iframe reloads it,
	 * cutting the audio. Leaving the node where it is avoids moving it at all.
	 */
	const KEEP = '[data-keep-on-navigate]'

	function swapBodyKeeping(newBody: HTMLElement, kept: Element, incoming: Element) {
		const body = document.body
		// The body class carries page state (intro progress, open overlays), so take the new
		// page's. The intro is never replayed mid-visit: it slides the footer, and the player
		// that is still playing in it, off screen.
		body.className = newBody.className
		body.classList.add('skip-intro')

		for (const node of [...body.childNodes]) {
			if (node !== kept) node.remove()
		}
		// Everything around the new page's copy of the kept node lands on the same side of ours.
		let beforeKept = true
		for (const node of [...newBody.childNodes]) {
			if (node === incoming) {
				beforeKept = false
				continue
			}
			if (beforeKept) body.insertBefore(node, kept)
			else body.append(node)
		}
	}

	document.addEventListener('astro:before-swap', (event) => {
		const kept = document.body.querySelector(`:scope > ${KEEP}`)
		const incoming = event.newDocument.body.querySelector(`:scope > ${KEEP}`)
		// A page without the marker gets Astro's default swap.
		if (!kept || !incoming) return

		event.swap = () => {
			const doc = event.newDocument
			swapFunctions.deselectScripts(doc)
			swapFunctions.swapRootAttributes(doc)
			swapFunctions.swapHeadElements(doc)
			swapBodyKeeping(doc.body, kept, incoming)
		}
	})
</script>

<style is:global>
	@font-face {
		font-display: swap;
		font-family: AkzidenzGroteskExtended;
		font-style: normal;
		font-weight: 500;
		src:
			url('/fonts/AkzidenzGrotesk/AkzidenzGrotesk-MediumExtended.woff2') format('woff2'),
			url('/fonts/AkzidenzGrotesk/AkzidenzGrotesk-MediumExtended.woff') format('woff'),
			url('/fonts/AkzidenzGrotesk/AkzidenzGrotesk-MediumExtended.otf') format('opentype');
	}

	*,
	*::after,
	*::before {
		box-sizing: border-box;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
		outline: none;
	}

	html,
	body,
	div,
	span,
	applet,
	object,
	iframe,
	h1,
	h2,
	h3,
	h4,
	h5,
	h6,
	p,
	blockquote,
	pre,
	a,
	abbr,
	acronym,
	address,
	big,
	cite,
	code,
	del,
	dfn,
	em,
	img,
	ins,
	kbd,
	q,
	s,
	samp,
	small,
	strike,
	strong,
	sub,
	sup,
	tt,
	var,
	b,
	u,
	i,
	center,
	dl,
	dt,
	dd,
	ol,
	ul,
	li,
	fieldset,
	form,
	label,
	legend,
	table,
	caption,
	tbody,
	tfoot,
	thead,
	tr,
	th,
	td,
	article,
	aside,
	canvas,
	details,
	embed,
	figure,
	figcaption,
	footer,
	header,
	hgroup,
	menu,
	nav,
	output,
	ruby,
	section,
	summary,
	time,
	mark,
	audio,
	video {
		margin: 0;
		padding: 0;
		border: 0;
		font: inherit;
		vertical-align: baseline;
	}

	div {
		vertical-align: top;
	}

	body {
		overscroll-behavior: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	article,
	aside,
	details,
	figcaption,
	figure,
	footer,
	header,
	hgroup,
	menu,
	nav,
	section {
		display: block;
	}

	ol,
	ul {
		list-style: none;
	}

	blockquote,
	q {
		quotes: none;
	}

	blockquote::before,
	blockquote::after,
	q::before,
	q::after {
		content: '';
		content: none;
	}

	table {
		border-collapse: collapse;
		border-spacing: 0;
	}

	img,
	svg,
	video {
		max-width: 100%;
		vertical-align: top;
	}

	html {
		font-family: AkzidenzGroteskExtended, Helvetica, Arial, sans-serif;
	}

	body {
		background: #fff;
		color: #000;
		width: 100vw;
		overflow-x: hidden;
		font-family: AkzidenzGroteskExtended, Helvetica, Arial, sans-serif;
		font-weight: 500;
		font-style: normal;
		font-size: calc(16 / 1920 * 100vw);
		line-height: 0.91;
		letter-spacing: -0.03em;
	}

	@media (max-width: 767px) {
		body {
			font-size: calc(12 / 375 * 100vw);
		}
	}
</style>
