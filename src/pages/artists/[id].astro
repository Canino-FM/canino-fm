---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import ShowCard from '@/components/ShowCard.astro'
import Search from '@/components/Search.astro'
import About from '@/components/About.astro'
import {
	fetchHomePageData,
	groupShowsByArtist,
	type ArchiveShow,
	type SiteArtist,
	type SettingsDoc,
} from '@/lib/sanity'

export async function getStaticPaths() {
	const data = await fetchHomePageData()
	const showsByArtist = groupShowsByArtist(data.archiveShows)
	const linkedArtists = data.artists.filter((artist) => showsByArtist.has(artist.id))

	return linkedArtists.map((artist) => ({
		params: { id: artist.slug },
		props: {
			artistName: artist.name,
			shows: showsByArtist.get(artist.id)!,
			allShows: data.archiveShows,
			allArtists: linkedArtists,
			settings: data.settings,
		},
	}))
}

interface Props {
	artistName: string
	shows: ArchiveShow[]
	allShows: ArchiveShow[]
	allArtists: SiteArtist[]
	settings: SettingsDoc
}

const { artistName, shows, allShows, allArtists, settings } = Astro.props
---

<BaseLayout title={`${artistName} — Canino FM`} skipIntro>
	<Header />
	<main class="main">
		<div class="main__container">
			<section class="artist-page">
				<div class="artist-page__container">
					<a class="back" href="/#artists">&larr; Artists</a>
					<h1 class="name">{artistName}</h1>
					<div class="grid">
						{shows.map((show) => <ShowCard show={show} />)}
					</div>
				</div>
			</section>
		</div>
	</main>
	<About settings={settings} />
	<Search shows={allShows} artists={allArtists} />
	<Footer />
	<script is:inline>
		;(function () {
			document.querySelectorAll('.artist-page .show[data-soundcloud]').forEach(function (el) {
				el.addEventListener('click', function () {
					const src = el.getAttribute('data-soundcloud') || ''
					if (!src) return
					const title = el.querySelector('.title')
					document.dispatchEvent(
						new CustomEvent('canino:play', {
							detail: { src: src, title: title ? title.textContent : '' },
						}),
					)
				})
			})
		})()
	</script>
</BaseLayout>

<style is:global>
	.artist-page__container {
		padding: calc(120 / 1920 * 100vw) calc(10 / 1920 * 100vw) calc(10 / 1920 * 100vw);
	}

	@media (max-width: 767px) {
		.artist-page__container {
			padding: calc(80 / 375 * 100vw) calc(5 / 375 * 100vw) 0;
		}
	}

	.artist-page .back {
		display: inline-block;
		/* Opens the gap above the name, so it is not crowded by the back link. */
		margin-bottom: calc(120 / 1920 * 100vw);
		text-transform: uppercase;
		cursor: pointer;
	}

	.artist-page .name {
		margin: 0 0 calc(40 / 1920 * 100vw);
		/* The site's largest size (artists list, about), rather than a one-off 64. */
		font-size: calc(42 / 1920 * 100vw);
		line-height: 0.91;
		letter-spacing: -0.03em;
		text-transform: uppercase;
	}

	@media (max-width: 767px) {
		.artist-page .back {
			margin-bottom: calc(80 / 375 * 100vw);
		}

		.artist-page .name {
			/* Matches the artists list on mobile, as 42 does on desktop. */
			font-size: calc(24 / 375 * 100vw);
			margin-bottom: calc(20 / 375 * 100vw);
		}
	}

	.artist-page .grid {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		column-gap: calc(10 / 1920 * 100vw);
		gap: calc(20 / 1920 * 100vw) calc(10 / 1920 * 100vw);
	}

	@media (max-width: 767px) {
		.artist-page .grid {
			grid-template-columns: 1fr 1fr;
			column-gap: calc(5 / 375 * 100vw);
			gap: calc(10 / 375 * 100vw) calc(5 / 375 * 100vw);
		}
	}
</style>
