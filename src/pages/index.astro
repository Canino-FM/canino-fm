---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/Header.astro'
import Hero from '@/components/Hero.astro'
import Archive from '@/components/Archive.astro'
import Artists from '@/components/Artists.astro'
import About from '@/components/About.astro'
import Search from '@/components/Search.astro'
import Footer from '@/components/Footer.astro'
import { fetchHomePageData, chunkArchiveShows, groupShowsByArtist } from '@/lib/sanity'

const data = await fetchHomePageData()
const archiveChunks = chunkArchiveShows(data.archiveShows, 30)
const showsByArtist = groupShowsByArtist(data.archiveShows)
const linkedArtists = data.artists.filter((artist) => showsByArtist.has(artist.id))
---

<BaseLayout skipIntro={import.meta.env.DEV} introOncePerSession>
	<Header />
	<main class="main">
		<div class="main__container">
			<Hero
				program={data.program}
				heroVideoHtml={data.heroVideoHtml}
				heroIframeSrc={data.heroIframeSrc}
			/>
			<Archive chunks={archiveChunks} />
			<Artists artists={data.artists} showsByArtist={showsByArtist} />
			<About settings={data.settings} />
			<Search shows={data.archiveShows} artists={linkedArtists} />
		</div>
	</main>
	<Footer />
	<script is:inline>
		;(function () {
			const body = document.body

			// Archive and Artists are display:none until the intro finishes, so on a cold load
			// they have no layout box and the browser's own fragment scroll lands nowhere.
			// Arriving at /#shows from an artist page or an external link would silently sit
			// at the top of the page, so the jump is re-applied once the sections exist.
			const pendingId = location.hash.length > 1 ? location.hash.slice(1) : ''

			function scrollToPending() {
				if (!pendingId) return
				const target = document.getElementById(pendingId)
				if (!target) return
				window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY })
			}

			if (!body.classList.contains('skip-intro')) {
				window.setTimeout(function () {
					body.classList.add('loaded')
				}, 1000)

				window.setTimeout(function () {
					body.classList.add('animated')
				}, 2000)

				window.setTimeout(function () {
					body.classList.add('no-transitions')
					scrollToPending()
				}, 2500)
			} else {
				// Already visible at parse time; re-applying is harmless and covers a slow paint.
				scrollToPending()
			}

			document.querySelectorAll('#shows .show[data-soundcloud]').forEach(function (el) {
				el.addEventListener('click', function () {
					const src = el.getAttribute('data-soundcloud') || ''
					if (!src) return
					const title = el.querySelector('.title')
					document.dispatchEvent(
						new CustomEvent('canino:play', {
							detail: { src: src, title: title ? title.textContent : '' },
						}),
					)
				})
			})

			document.querySelectorAll('.menu .item a[href*="#"]').forEach(function (link) {
				link.addEventListener('click', function (e) {
					const href = link.getAttribute('href') || ''
					const id = href.slice(href.indexOf('#') + 1)
					if (!id) return
					// getElementById over querySelector: a fragment that is not a valid CSS
					// selector (a leading digit, an encoded character) makes querySelector throw.
					const target = document.getElementById(id)
					// Not on this page, so fall through and let the browser navigate.
					if (!target) return
					// Both overlays cover the viewport; leaving one open hides the section we scroll to.
					body.classList.remove('show-about')
					body.classList.remove('show-search')
					e.preventDefault()
					const top = target.getBoundingClientRect().top + window.scrollY
					window.scrollTo({ top: top, behavior: 'smooth' })
				})
			})

			document.addEventListener('click', function (e) {
				const t = e.target
				if (!(t instanceof Element)) return
				const loadMore = t.closest('.load-more')
				if (!loadMore) return
				const group = loadMore.closest('.group')
				if (!group || !group.parentElement) return
				group.classList.add('loaded')
				group.classList.remove('active')
				const next = group.nextElementSibling
				if (next && next.classList.contains('group')) {
					next.classList.add('active')
				}
			})
		})()
	</script>
</BaseLayout>

<style is:global>
	.main__container {
		padding-bottom: 100px;
	}
</style>
