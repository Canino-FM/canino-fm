---
import type { ArchiveShow, SiteArtist } from '@/lib/sanity'

interface Props {
	shows: ArchiveShow[]
	artists: SiteArtist[]
}

const { shows, artists } = Astro.props

interface SearchRecord {
	type: 'show' | 'artist'
	title: string
	subtitle: string
	soundcloudSrc?: string
	href?: string
}

const records: SearchRecord[] = [
	...shows.map(
		(show): SearchRecord => ({
			type: 'show',
			title: show.showTitle,
			subtitle: show.artists.map((a) => a.name).join(', ') || show.eventDate,
			soundcloudSrc: show.soundcloudSrc,
		}),
	),
	...artists.map(
		(artist): SearchRecord => ({
			type: 'artist',
			title: artist.name,
			subtitle: 'Artist',
			href: `/artists/${artist.slug}`,
		}),
	),
]

const searchIndexJson = JSON.stringify(records).replace(/</g, '\\u003c')
---

<div class="search">
	<div class="search__container">
		<input
			id="search-input"
			class="search__input"
			type="search"
			placeholder="Search shows or artists…"
			autocomplete="off"
		/>
		<ul id="search-results" class="search__results"></ul>
	</div>
</div>

{/* set:html does not escape, so a "<" in a show title could close this block early and
   truncate the JSON. < is valid inside a JSON string and parses back to "<". */}
<script type="application/json" id="search-data" is:inline set:html={searchIndexJson} />

<script>
	import Fuse from 'fuse.js'
	import { navigate } from 'astro:transitions/client'

	interface SearchRecord {
		type: 'show' | 'artist'
		title: string
		subtitle: string
		soundcloudSrc?: string
		href?: string
	}

	const dataEl = document.getElementById('search-data')
	let records: SearchRecord[] = []
	try {
		records = dataEl?.textContent ? JSON.parse(dataEl.textContent) : []
	} catch (error) {
		// Without this the throw would kill the module before the toggle is bound below,
		// leaving the Search button a dead no-op with nothing to explain it.
		console.error('[search] could not read the search index; search will find nothing', error)
	}

	const fuse = new Fuse(records, {
		keys: ['title', 'subtitle'],
		threshold: 0.35,
	})

	// Reassigned by bindSearch: client-side navigation replaces the overlay with a fresh copy.
	let input: HTMLInputElement | null = null
	let results: HTMLElement | null = null

	function playShow(soundcloudSrc: string, title: string) {
		if (!soundcloudSrc) return
		document.dispatchEvent(
			new CustomEvent('canino:play', { detail: { src: soundcloudSrc, title } }),
		)
	}

	function closeSearch() {
		document.body.classList.remove('show-search')
	}

	function renderResults(matches: SearchRecord[]) {
		if (!results) return
		results.replaceChildren()
		for (const record of matches.slice(0, 30)) {
			const li = document.createElement('li')
			li.className = `search__result search__result--${record.type}`
			const title = document.createElement('p')
			title.className = 'title'
			title.textContent = record.title
			const subtitle = document.createElement('p')
			subtitle.className = 'subtitle'
			subtitle.textContent = record.subtitle
			li.appendChild(title)
			li.appendChild(subtitle)
			li.addEventListener('click', () => {
				if (record.type === 'artist' && record.href) {
					// A full page load here would stop the player.
					navigate(record.href)
					return
				}
				if (record.type === 'show' && record.soundcloudSrc) {
					playShow(record.soundcloudSrc, record.title)
				}
				// Closes either way: a show with no audio used to leave the overlay open, so
				// the click looked like the page had frozen.
				closeSearch()
			})
			results.appendChild(li)
		}
	}

	function toggleSearch() {
		// Keep the two overlays mutually exclusive, so closing Search never reveals a stale About.
		document.body.classList.remove('show-about')
		document.body.classList.toggle('show-search')
		if (document.body.classList.contains('show-search')) {
			input?.focus()
		}
	}

	/** Runs once per visit, then again after each navigation for that page's fresh elements. */
	function bindSearch() {
		input = document.getElementById('search-input') as HTMLInputElement | null
		results = document.getElementById('search-results')

		const field = input
		field?.addEventListener('input', () => {
			const query = field.value.trim()
			if (!query) {
				renderResults([])
				return
			}
			renderResults(fuse.search(query).map((r) => r.item))
		})

		document.querySelectorAll('.button--search').forEach((btn) => {
			btn.addEventListener('click', toggleSearch)
			btn.addEventListener('keydown', (e) => {
				if (e instanceof KeyboardEvent && (e.key === 'Enter' || e.key === ' ')) {
					e.preventDefault()
					toggleSearch()
				}
			})
		})

		document.querySelector('.search')?.addEventListener('click', (e) => {
			if (e.target === e.currentTarget) closeSearch()
		})
	}

	bindSearch()
	document.addEventListener('astro:after-swap', bindSearch)

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeSearch()
	})
</script>

<style is:global>
	.search {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 2;
		width: 100%;
		height: 100vh;
		background: rgba(255, 255, 255, 0.97);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
		overflow-y: auto;
	}

	body.show-search .search {
		opacity: 1;
		pointer-events: all;
	}

	.search__container {
		padding: calc(120 / 1920 * 100vw) calc(10 / 1920 * 100vw) calc(10 / 1920 * 100vw);
	}

	@media (max-width: 767px) {
		.search__container {
			padding: calc(80 / 375 * 100vw) calc(5 / 375 * 100vw);
		}
	}

	.search__input {
		width: 100%;
		border: none;
		border-bottom: 1px solid #000;
		padding-bottom: calc(10 / 1920 * 100vw);
		background: transparent;
		font: inherit;
		font-size: calc(42 / 1920 * 100vw);
		letter-spacing: -0.03em;
	}

	@media (max-width: 767px) {
		.search__input {
			font-size: calc(24 / 375 * 100vw);
		}
	}

	.search__input:focus {
		outline: none;
	}

	.search__results {
		margin-top: calc(20 / 1920 * 100vw);
	}

	.search__result {
		padding: calc(10 / 1920 * 100vw) 0;
		border-bottom: 1px solid rgba(0, 0, 0, 0.1);
		cursor: pointer;
		text-transform: uppercase;
	}

	.search__result .title {
		margin: 0;
		font-size: calc(24 / 1920 * 100vw);
		line-height: 0.91;
		letter-spacing: -0.03em;
	}

	.search__result .subtitle {
		margin: 0;
		opacity: 0.6;
		font-size: calc(14 / 1920 * 100vw);
	}

	@media (max-width: 767px) {
		.search__result .title {
			font-size: calc(18 / 375 * 100vw);
		}
		.search__result .subtitle {
			font-size: calc(12 / 375 * 100vw);
		}
	}
</style>
